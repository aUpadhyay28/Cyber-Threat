# Copy to .env (which is gitignored), fill in, then `docker compose up`.
# Generate each secret with:  python -c "import secrets;print(secrets.token_urlsafe(32))"

# Instead of putting a secret here you can point at a file holding it, e.g.
# RISK_API_KEY_FILE=/run/secrets/risk_api_key (Docker/Kubernetes secrets). Several comma-separated
# keys are accepted per variable, which is how you rotate one without downtime.

# --- required ---------------------------------------------------------------------------------
# Three keys, three roles - all different, >= 24 characters each.
# The login backend: /v1/score and /v1/confirm only. This is the only key your web app gets.
RISK_API_KEY=
# The analyst review console: queue, event detail, verdicts, stats.
RISK_ANALYST_KEY=
# Operators: model reload, account erasure, retention. Keep it off every application server.
RISK_ADMIN_KEY=
# Password for Redis (docker compose starts Redis with it and builds RISK_REDIS_URL from it).
REDIS_PASSWORD=
# Secret key for hashing user IDs and IPs. Use the SAME value for scripts/import_history.py,
# scripts/prepare_data.py and the service, and never change it casually: a new key orphans every
# stored profile until you re-import history.
RISK_HASH_KEY=
# SHA-256 of the model you deploy: `cat models/latest.joblib.sha256` after scripts/pin_model.py.
RISK_MODEL_SHA256=

# --- mode ----------------------------------------------------------------------------------------
# production = refuse to start unless timestamps, hashing, model pin and GeoIP are all configured.
RISK_ENV=production
# maxmind = country/ASN resolved from the IP using geoip/GeoLite2-Country.mmdb and GeoLite2-ASN.mmdb
# (free MaxMind account). Only set "client" for a local demo.
RISK_GEOIP_MODE=maxmind

# --- policy ------------------------------------------------------------------------------------
# Logins from a country this account has never used are raised to at least Medium (OTP).
RISK_HOME_COUNTRIES=IN
# Shadow mode: log-only until this many logins have been seen. Lower it only after retraining on
# your own traffic (PRODUCTION.md stage 3).
RISK_WARMUP_MIN_EVENTS=1000000

# --- optional ------------------------------------------------------------------------------------
# If set, Prometheus must send `Authorization: Bearer <token>` to read /metrics.
# RISK_METRICS_TOKEN=
# RISK_RATE_LIMIT_PER_MIN=1200
# RISK_LOG_LEVEL=INFO
